+
+bool SdlInputHandler::handleLocalControlEvent(const SDL_Event& event)
+{
+    if (!m_LocalControls.handles(event)) return false;
+    // Keep local capture/stop shortcuts available while the controls own focus.
+    if (event.type == SDL_KEYDOWN && (event.key.keysym.mod & KMOD_CTRL) &&
+#ifdef Q_OS_DARWIN
+        (event.key.keysym.mod & KMOD_GUI) &&
+#else
+        (event.key.keysym.mod & KMOD_ALT) &&
+#endif
+        (event.key.keysym.mod & KMOD_SHIFT)) {
+        SDL_KeyboardEvent key = event.key;
+        handleKeyEvent(&key);
+        return true;
+    }
+    auto action = m_LocalControls.handle(event);
+    if (action == AntCloudControls::Resume) {
+        m_LocalControls.hide();
+        SDL_RaiseWindow(m_Window);
+        setCaptureActive(true);
+    }
+    else if (action == AntCloudControls::Shutdown) {
+        if (!m_LocalControls.confirmShutdown()) return true;
+        if (!m_LocalControls.requestShutdown()) {
+            SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Shutdown request could not be sent",
+                "Check the AntCloud dashboard. No shutdown request was confirmed.", m_Window);
+            return true;
+        }
+    }
+    if (action == AntCloudControls::Stop || action == AntCloudControls::Shutdown) {
+        // Exit locally without GameStream quitApp. Only confirmed Shutdown reaches the provider.
+        Session::get()->requestLocalStop();
+    }
+    return true;
+}
