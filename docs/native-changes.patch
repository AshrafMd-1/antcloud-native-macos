+// All provider network objects and timers live on this worker's own QThread.
+#pragma once
+#include "protocol.h"
+#include <QObject>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QSet>
+#include <QTimer>
+#include <QWebSocket>
+#include <functional>
+
+namespace AntCloud {
+class ProviderWorker : public QObject {
+    Q_OBJECT
+public:
+    explicit ProviderWorker(QObject* parent = nullptr);
+public slots:
+    void initialize();
+    void restore();
+    void login(QString email, QString password, bool remember);
+    void signOut();
+    void start(int width, int height, int fps, int bitrate);
+    void pair(QString pin);
+    void stop();
+    void stopAfterStream();
+    void shutdown();
+signals:
+    void account(bool signedIn, int limit, QString notice);
+    void authenticationFailed(QString message);
+    void stage(QString name, QString detail);
+    void hostAvailable(QString address);
+    void nativeReady();
+    void ended(QString message);
+    void notice(QString message);
+    void shutdownRequested();
+private:
+    using Reply = std::function<void(int, QJsonObject)>;
+    void request(const QString& path, const QJsonObject& body, bool post, bool session, Reply callback);
+    void authenticateToken(const QString& token);
+    void acceptAccount(const QJsonObject& value, const QString& token, bool remember);
+    void receive(const QString& packet);
+    void poll();
+    void checkConnection();
+    void finish(const QString& message);
+    bool send(const QString& packet);
+    void clearRequests(bool sessionOnly);
+    QNetworkAccessManager* m_Network = nullptr;
+    QWebSocket* m_Socket = nullptr;
+    QTimer *m_Poll = nullptr, *m_Startup = nullptr, *m_Heartbeat = nullptr;
+    QSet<QNetworkReply*> m_Requests;
+    QString m_Token, m_Address;
+    int m_Limit = 0, m_Generation = 0, m_AuthGeneration = 0, m_HeartbeatMs = 45000;
+    bool m_Active = false, m_Namespace = false, m_Polling = false, m_RequestPending = false;
+    bool m_Ready = false, m_Shutdown = false, m_PinSubmitted = false;
+    StreamSettings m_Settings;
+#ifdef ANTCLOUD_TESTING
+    friend class ProviderWorkerTest;
+    QUrl m_Api = QUrl("https://api.antcloud.co");
+    QUrl m_Stream = QUrl("wss://socket.antcloud.co:8000/socket.io/");
+#endif
+};
+}
diff --git a/app/antcloud/streambridge.h b/app/antcloud/streambridge.h
new file mode 100644
index 0000000..afb6d5a
--- /dev/null
+++ b/app/antcloud/streambridge.h
@@ -0,0 +1,39 @@
+// Process-local control channel. Account tokens and passwords stay on the worker.
+#pragma once
+#include <QObject>
+#include <QMutex>
+#include <QMutexLocker>
+#include <atomic>
+#include "SDL_compat.h"
+
+namespace AntCloud {
+class StreamBridge {
+public:
+    static void install(QObject* worker) { QMutexLocker lock(&mutex()); target() = worker; enabledFlag() = worker != nullptr; }
+    static bool enabled() { return enabledFlag().load(); }
+    static void setHostRequestsAllowed(bool value) { allowedFlag() = value; }
+    static void setClosing() { closingFlag() = true; }
+    static bool hostRequestsAllowed() { return !closingFlag().load() && (!enabled() || allowedFlag().load()); }
+    static bool shutdown() {
+        QMutexLocker lock(&mutex());
+        return target() && QMetaObject::invokeMethod(target(), "shutdown", Qt::QueuedConnection);
+    }
+    static void pair(const QString& pin) {
+        QMutexLocker lock(&mutex());
+        if (target()) QMetaObject::invokeMethod(target(), "pair", Qt::QueuedConnection, Q_ARG(QString, pin));
+    }
+    static void setActive(bool value) { activeFlag() = value; }
+    static bool active() { return activeFlag().load(); }
+    static void interrupt() {
+        if (!active()) return;
+        SDL_Event event{}; event.type = SDL_QUIT; SDL_PushEvent(&event);
+    }
+private:
+    static QObject*& target() { static QObject* value = nullptr; return value; }
+    static QMutex& mutex() { static QMutex value; return value; }
+    static std::atomic<bool>& enabledFlag() { static std::atomic<bool> value{false}; return value; }
+    static std::atomic<bool>& activeFlag() { static std::atomic<bool> value{false}; return value; }
+    static std::atomic<bool>& allowedFlag() { static std::atomic<bool> value{false}; return value; }
+    static std::atomic<bool>& closingFlag() { static std::atomic<bool> value{false}; return value; }
+};
+}
diff --git a/app/antcloud/tokenstore.cpp b/app/antcloud/tokenstore.cpp
new file mode 100644
index 0000000..686f79e
--- /dev/null
+++ b/app/antcloud/tokenstore.cpp
@@ -0,0 +1,88 @@
+#include "tokenstore.h"
+#include "protocol.h"
+#if defined(Q_OS_MACOS) && !defined(ANTCLOUD_TESTING)
+#include <Security/Security.h>
+#include <CoreFoundation/CoreFoundation.h>
+
+namespace {
+CFMutableDictionaryRef query() {
+    auto value = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(value, kSecClass, kSecClassGenericPassword);
+    CFDictionarySetValue(value, kSecAttrService, CFSTR("day.ashraf.antcloud.native.login"));
+    CFDictionarySetValue(value, kSecAttrAccount, CFSTR("access-token"));
+    CFDictionarySetValue(value, kSecAttrSynchronizable, kCFBooleanFalse);
+    return value;
+}
+}
+#endif
+
+QString AntCloud::TokenStore::load(QString& error) {
+    error.clear();
+#if defined(Q_OS_MACOS) && !defined(ANTCLOUD_TESTING)
+    auto request = query();
+    CFDictionarySetValue(request, kSecReturnData, kCFBooleanTrue);
+    CFDictionarySetValue(request, kSecMatchLimit, kSecMatchLimitOne);
+    CFTypeRef result = nullptr;
+    OSStatus status = SecItemCopyMatching(request, &result);
+    CFRelease(request);
+    if (status == errSecItemNotFound) return {};
+    if (status != errSecSuccess) {
+        error = QStringLiteral("Keychain could not read the saved login. You can sign in for this run.");
+        return {};
+    }
+    QString token;
+    if (result && CFGetTypeID(result) == CFDataGetTypeID()) {
+        auto data = static_cast<CFDataRef>(result);
+        if (CFDataGetLength(data) <= 16384)
+            token = QString::fromUtf8(reinterpret_cast<const char*>(CFDataGetBytePtr(data)), CFDataGetLength(data));
+    }
+    if (result) CFRelease(result);
+    if (!validToken(token)) {
+        error = QStringLiteral("The saved login has an invalid format. Sign in again to replace it.");
+        return {};
+    }
+    return token;
+#else
+    return {};
+#endif
+}
+
+bool AntCloud::TokenStore::save(const QString& token, QString& error) {
+    error.clear();
+    if (!validToken(token)) { error = "Login token has an invalid format."; return false; }
+#if defined(Q_OS_MACOS) && !defined(ANTCLOUD_TESTING)
+    const auto bytes = token.toUtf8();
+    auto data = CFDataCreate(kCFAllocatorDefault, reinterpret_cast<const UInt8*>(bytes.constData()), bytes.size());
+    auto request = query();
+    auto update = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(update, kSecValueData, data);
+    OSStatus status = SecItemUpdate(request, update);
+    if (status == errSecItemNotFound) {
+        CFDictionarySetValue(request, kSecValueData, data);
+        CFDictionarySetValue(request, kSecAttrAccessible, kSecAttrAccessibleWhenUnlockedThisDeviceOnly);
+        status = SecItemAdd(request, nullptr);
+    }
+    CFRelease(update); CFRelease(request); CFRelease(data);
+    if (status == errSecSuccess) return true;
+    error = "Keychain could not save the login. This run can continue; you will need to sign in next time.";
+#else
+    error = "Remembered login is available in the macOS build only.";
+#endif
+    return false;
+}
+
+bool AntCloud::TokenStore::clear(QString& error) {
+    error.clear();
+#if defined(Q_OS_MACOS) && !defined(ANTCLOUD_TESTING)
+    auto request = query();
+    OSStatus status = SecItemDelete(request);
+    CFRelease(request);
+    if (status == errSecSuccess || status == errSecItemNotFound) return true;
+    error = "Keychain could not remove the saved login. Remove the AntCloud login item in Passwords / Keychain Access.";
+    return false;
+#else
+    return true;
+#endif
+}
